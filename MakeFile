CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -g
LDFLAGS =

# Object files
CLIENT_OBJS = client.o protocol.o
SERVER_OBJS = server.o connection.o protocol.o

# Executables
CLIENT = client
SERVER = server

all: $(CLIENT) $(SERVER)

$(CLIENT): $(CLIENT_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^

$(SERVER): $(SERVER_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(CLIENT_OBJS) $(SERVER_OBJS) $(CLIENT) $(SERVER)

.PHONY: all clean
